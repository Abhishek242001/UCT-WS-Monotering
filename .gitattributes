# Repo stores text as LF. Windows launchers keep CRLF because cmd.exe
# needs it; shell scripts must stay LF or bash fails on the stray \r.
* text=auto eol=lf
*.sh  text eol=lf
*.bat text eol=crlf

# Never touch binaries.
*.pt   binary
*.png  binary
*.jpg  binary
*.mp4  binary
*.docx binary
*.zip  binary
*.woff2 binary
