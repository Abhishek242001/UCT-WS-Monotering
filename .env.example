# Copy this file to .env and adjust as needed. All values shown are the
# defaults the application falls back to if unset.

# --- Backend ---
DATABASE_URL=sqlite:///./data.db
FRONTEND_ORIGIN=http://localhost:8002
DEFAULT_ADMIN_USERNAME=hr_admin1
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
YOLO_MODEL_PATH=yolov8n.pt
ENROLLMENT_PHOTO_DIR=./enrollment_photos
DATASET_DIR=./datasets
UPLOADED_VIDEOS_DIR=./uploaded_videos
MAX_VIDEO_UPLOAD_BYTES=524288000
DEFAULT_DEMO_ORG_ID=1
ATTENDANCE_GRACE_PERIOD_SECONDS=600
ATTENDANCE_AWAY_TIMEOUT_SECONDS=3600
IDENTIFY_HEARTBEAT_SECONDS=30

# Only relevant once requirements-face-recognition.txt is installed:
INSIGHTFACE_PACK=buffalo_s

# --- Frontend ---
# The frontend resolves the backend URL automatically from its own
# window.location (see frontend/index.html, getBackendBaseUrl()) -- no
# env var needed here for local dev on ports 8001/8002. On Lightning.ai,
# it derives the backend's subdomain from its own, per Section 10.2 of the
# project documentation.
